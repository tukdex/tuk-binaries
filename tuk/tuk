#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# tuk: install and verify approved Tuk utilities from pinned public releases.
# The package catalogue is data (packages.conf); it is parsed, never sourced.
set -euo pipefail
(( BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4) )) || { echo 'tuk: Bash 4.4 or newer is required' >&2; exit 1; }
umask 077

TUK_VERSION=0.1.0
# The single maintained prerequisite list; ./bootstrap reads it via `_required-tools`.
REQUIRED_TOOLS=(curl sha256sum stat mktemp cp mv ln rm chmod install realpath flock date sort mkdir dirname uname cat head timeout)
RELEASE_BASE=https://github.com/tukdex/tuk-binaries/releases/download

die() { printf 'tuk: %s\n' "$*" >&2; exit 1; }
warn() { printf 'tuk: warning: %s\n' "$*" >&2; }
usage_error() { printf 'tuk: %s\nTry: tuk --help\n' "$*" >&2; exit 2; }

CLEAN=()
DONE_LIST=()
ROLLBACK_SRC=''; ROLLBACK_DEST=''; ROLLBACK_SHA=''; ROLLBACK_VER=''
ROLLBACK_NEW_DEST=''; ROLLBACK_NEW_SHA=''
JUST_INSTALLED=0
cleanup() {
    local rc=$? p
    if (( rc != 0 && ${#DONE_LIST[@]} > 0 )); then
        printf 'tuk: installed before the failure: %s (later tools were not attempted)\n' "${DONE_LIST[*]}" >&2
    fi
    if (( rc != 0 )) && [[ -n $ROLLBACK_SRC ]]; then
        local t
        if t=$(mktemp -- "${ROLLBACK_DEST%/*}/.tuk.XXXXXXXX") && cp -- "$ROLLBACK_SRC" "$t" && chmod 0644 -- "$t" \
           && mv -fT -- "$t" "$ROLLBACK_DEST" && record_set catalogue "$ROLLBACK_VER" "$ROLLBACK_SHA" "$ROLLBACK_DEST" manager; then
            printf 'tuk: restored the previous catalogue after the manager step failed\n' >&2
        else
            printf 'tuk: WARNING: could not restore the previous catalogue at %s\n' "$ROLLBACK_DEST" >&2
        fi
    fi
    if (( rc != 0 )) && [[ -n $ROLLBACK_NEW_DEST ]]; then
        # The catalogue was created by this run; remove it only if it is still exactly our file.
        if [[ -f $ROLLBACK_NEW_DEST && ! -L $ROLLBACK_NEW_DEST && $(sha256_of "$ROLLBACK_NEW_DEST" || true) == "$ROLLBACK_NEW_SHA" ]] \
           && rm -f -- "$ROLLBACK_NEW_DEST" && record_unset catalogue; then
            printf 'tuk: removed the catalogue created by this run because the manager step failed\n' >&2
        else
            printf 'tuk: WARNING: could not remove the catalogue created by this run at %s\n' "$ROLLBACK_NEW_DEST" >&2
        fi
    fi
    for p in "${CLEAN[@]}"; do rm -rf -- "$p"; done
}
trap cleanup EXIT

# --- Locations ---------------------------------------------------------------
# TUK_TEST_PREFIX redirects every path into a scratch directory and allows a
# file:/// base URL, for offline tests only. It is refused for root, and sudo
# strips it, so it can never steer a privileged run.
TEST_MODE=0
if [[ -n ${TUK_TEST_PREFIX:-} ]]; then
    (( EUID != 0 )) || die 'TUK_TEST_PREFIX is not accepted when running as root'
    [[ $TUK_TEST_PREFIX == /* && -d $TUK_TEST_PREFIX ]] || die 'TUK_TEST_PREFIX must be an existing absolute directory'
    TEST_MODE=1
    BIN_DIR=$TUK_TEST_PREFIX/bin
    LIB_DIR=$TUK_TEST_PREFIX/lib/tuk
    STATE_DIR=$TUK_TEST_PREFIX/var/tuk
    BASE_URL=${TUK_TEST_BASE_URL:-$RELEASE_BASE}
    [[ $BASE_URL == "$RELEASE_BASE" || $BASE_URL == file:///* ]] || die 'TUK_TEST_BASE_URL must be a file:/// URL'
    warn 'test mode: paths redirected to TUK_TEST_PREFIX'
else
    BIN_DIR=/usr/local/bin
    LIB_DIR=/usr/local/lib/tuk
    STATE_DIR=/var/lib/tuk
    BASE_URL=$RELEASE_BASE
fi
CATALOGUE=$LIB_DIR/packages.conf
RECORD=$STATE_DIR/installed.tsv
HOST_OS=$(uname -s 2> /dev/null || echo unknown)
HOST_ARCH=$(uname -m 2> /dev/null || echo unknown)

# --- Catalogue (strict, declarative) ----------------------------------------
REQUIRED_KEYS=(description version release os arch payload payload_sha256 payload_size installer installer_sha256 manifest requires)
re_section='^\[([a-z][a-z0-9-]{0,31})\]$'
re_kv='^([a-z0-9_]+) = (.+)$'
re_name='^[a-z][a-z0-9-]{0,31}$'
re_desc='^[A-Za-z0-9][A-Za-z0-9 .,()/+:_-]{0,99}$'
re_version='^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z]+)*$'
re_asset='^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$'
re_arch='^[a-z0-9_]+(,[a-z0-9_]+)*$'
re_requires='^(none|[a-z0-9_-]+( [a-z0-9_-]+)*)$'
re_sha='^[0-9a-f]{64}$'
re_size='^[1-9][0-9]{0,9}$'
MAX_PAYLOAD=1073741824
MAX_INSTALLER=1048576

declare -A P=()      # P[name:key] = value
PKG_NAMES=()
CAT_ERR=''

valid_value() {
    local key=$1 val=$2
    case $key in
        description) [[ $val =~ $re_desc && $val != *' ' ]] ;;
        version) [[ $val =~ $re_version ]] ;;
        release|payload|installer|manifest) [[ $val =~ $re_asset && $val != *..* ]] ;;
        os) [[ $val == linux ]] ;;
        arch) [[ $val =~ $re_arch ]] ;;
        requires) [[ $val =~ $re_requires ]] ;;
        payload_sha256|installer_sha256) [[ $val =~ $re_sha ]] ;;
        payload_size) [[ $val =~ $re_size ]] && (( val <= MAX_PAYLOAD )) ;;
        *) return 1 ;;
    esac
}

_load_catalogue() {
    local file=$1 line n=0 cur='' key val k schema=0 name
    local -A seen=()
    P=(); PKG_NAMES=(); CAT_ERR=''
    [[ -f $file && ! -L $file ]] || { CAT_ERR="$file is missing or not a regular file"; return 1; }
    while IFS= read -r line || [[ -n $line ]]; do
        n=$((n + 1))
        if [[ -z $line || $line == '#'* ]]; then continue; fi
        if [[ $line =~ $re_section ]]; then
            cur=${BASH_REMATCH[1]}
            if [[ $cur == tuk || $cur == catalogue ]]; then CAT_ERR="line $n: reserved name '$cur'"; return 1; fi
            if [[ -n ${seen[$cur:]:-} ]]; then CAT_ERR="line $n: duplicate package '$cur'"; return 1; fi
            seen[$cur:]=1
            PKG_NAMES+=("$cur")
        elif [[ $line =~ $re_kv ]]; then
            key=${BASH_REMATCH[1]}
            val=${BASH_REMATCH[2]}
            if [[ -z $cur ]]; then
                if [[ $key == schema && $val == 1 && $schema == 0 ]]; then schema=1; continue; fi
                CAT_ERR="line $n: only 'schema = 1' is allowed before the first package"; return 1
            fi
            if [[ -n ${seen[$cur:$key]:-} ]]; then CAT_ERR="line $n: duplicate key '$key' in [$cur]"; return 1; fi
            valid_value "$key" "$val" || { CAT_ERR="line $n: invalid or unknown $key in [$cur]"; return 1; }
            seen[$cur:$key]=1
            P[$cur:$key]=$val
        else
            CAT_ERR="line $n: unrecognised syntax"; return 1
        fi
    done < "$file"
    (( schema == 1 )) || { CAT_ERR='missing "schema = 1"'; return 1; }
    (( ${#PKG_NAMES[@]} > 0 )) || { CAT_ERR='catalogue has no packages'; return 1; }
    for name in "${PKG_NAMES[@]}"; do
        for k in "${REQUIRED_KEYS[@]}"; do
            [[ -n ${seen[$name:$k]:-} ]] || { CAT_ERR="[$name] is missing '$k'"; return 1; }
        done
        # Staged files share one directory, so their names must not collide.
        if [[ ${P[$name:payload]} == "${P[$name:installer]}" || ${P[$name:payload]} == "${P[$name:manifest]}" || ${P[$name:installer]} == "${P[$name:manifest]}" ]]; then
            CAT_ERR="[$name] payload, installer and manifest names must differ"; return 1
        fi
    done
}

load_catalogue() {
    _load_catalogue "$1" || { P=(); PKG_NAMES=(); return 1; }
}

# --- Helpers -----------------------------------------------------------------
sha256_of() {
    local out
    out=$(sha256sum -- "$1") || return 1
    printf '%s' "${out%% *}"
}

# --- Trust checks ------------------------------------------------------------
# Production: every component up to / must be owned by root and not writable by
# group or others (a sticky root-owned ancestor such as /tmp is tolerated, since
# others cannot replace entries they do not own). Symlinks on the path must be
# root-owned and sit in trusted directories; the resolved path is checked too.
# Test mode (TUK_TEST_PREFIX, never root) applies the same rules from the prefix
# downwards and accepts the invoking user as owner; it never relaxes production.
TRUST_WHY=''; TRUST_PATH=''; TRUST_KIND=''; TRUST_GROUP=''
META_MODE=''; META_OWNER=''

file_meta() { # sets META_MODE and META_OWNER (of a symlink itself, not its target)
    local out
    out=$(stat -c '%a %u' -- "$1") || return 1
    read -r META_MODE META_OWNER <<< "$out"
}

owner_ok() { [[ $1 == 0 ]] || { (( TEST_MODE )) && [[ $1 == "$EUID" ]]; }; }

component_ok() { # path kind(leaf|ancestor): ownership and write permission of one entry
    local p=$1 kind=$2
    file_meta "$p" || { TRUST_WHY="cannot stat $p"; TRUST_PATH=$p; TRUST_KIND=stat; return 1; }
    if ! owner_ok "$META_OWNER"; then TRUST_WHY="$p is owned by uid $META_OWNER"; TRUST_PATH=$p; TRUST_KIND=owner; return 1; fi
    if [[ -L $p ]]; then return 0; fi
    if (( (8#$META_MODE & 8#022) != 0 )); then
        if [[ $kind == ancestor && -d $p ]] && (( 8#$META_MODE & 8#1000 )) && [[ $META_OWNER == 0 ]]; then return 0; fi
        TRUST_WHY="$p is writable by group or others (mode $META_MODE)"; TRUST_PATH=$p; TRUST_KIND=writable
        TRUST_GROUP=$(stat -c %G -- "$p" 2> /dev/null || echo unknown)
        return 1
    fi
}

# Exact, copy-pasteable guidance for the last failed trusted_path. tuk never
# changes permissions or ownership itself.
trust_advice() {
    case $TRUST_KIND in
        writable) printf 'tuk never changes permissions. Inspect it with: ls -ld -- %s ; getent group %s ; and, if you accept removing the extra write access, run as root: chmod g-w,o-w -- %s' \
                      "$TRUST_PATH" "$TRUST_GROUP" "$TRUST_PATH" ;;
        owner) printf 'tuk never changes ownership. Find out why with: ls -ld -- %s ; and, if appropriate, run as root: chown root:root -- %s' "$TRUST_PATH" "$TRUST_PATH" ;;
        *) printf 'check the path with: ls -ld -- %s' "${TRUST_PATH:-the path above}" ;;
    esac
}

trust_fail() { die "$1: $TRUST_WHY. $(trust_advice)"; }

# The nearest existing ancestor of a path that may not exist yet must be trusted.
check_location() {
    local p=$1
    while [[ ! -e $p && ! -L $p ]]; do p=${p%/*}; p=${p:-/}; done
    trusted_path "$p"
}

trusted_path() { # path: leaf and all ancestors, lexical and resolved
    local path=$1 real cur comp stop='' parts=() n i
    TRUST_WHY=''
    [[ $path == /* ]] || { TRUST_WHY="$path is not absolute"; return 1; }
    real=$(realpath -e -- "$path") || { TRUST_WHY="cannot resolve $path"; return 1; }
    if (( TEST_MODE )); then stop=$(realpath -e -- "$TUK_TEST_PREFIX") || return 1; fi
    # Lexical prefixes: catches symlinked components that resolution would hide.
    IFS=/ read -ra parts <<< "${path#/}"
    cur=''
    n=${#parts[@]}
    for ((i = 0; i < n; i++)); do
        comp=${parts[i]}
        if [[ -z $comp || $comp == . ]]; then continue; fi
        cur+=/$comp
        if (( TEST_MODE )) && [[ $cur != "$stop"/* ]]; then continue; fi
        if (( i == n - 1 )); then component_ok "$cur" leaf || return 1
        else component_ok "$cur" ancestor || return 1; fi
    done
    # Resolved path: the leaf, then every ancestor up to / (or the test prefix).
    cur=$real
    component_ok "$cur" leaf || return 1
    while [[ $cur != / ]]; do
        if (( TEST_MODE )) && [[ $cur == "$stop" ]]; then return 0; fi
        cur=${cur%/*}; cur=${cur:-/}
        component_ok "$cur" ancestor || return 1
    done
}

load_catalogue_or_die() {
    [[ -e $CATALOGUE ]] || die "catalogue not found at $CATALOGUE; run ./bootstrap from tuk-binaries first"
    trusted_path "$LIB_DIR" && trusted_path "$CATALOGUE" || trust_fail "untrusted catalogue location"
    load_catalogue "$CATALOGUE" || die "invalid catalogue: $CAT_ERR"
}

arch_ok() {
    local list x
    IFS=, read -ra list <<< "${P[$1:arch]}"
    for x in "${list[@]}"; do
        if [[ $x == any || $x == "$HOST_ARCH" ]]; then return 0; fi
    done
    return 1
}

missing_requires() {
    local c out=''
    [[ ${P[$1:requires]} == none ]] && return 0
    for c in ${P[$1:requires]}; do
        command -v -- "$c" > /dev/null 2>&1 || out+="${out:+ }$c"
    done
    printf '%s' "$out"
}

# --- Installation record -----------------------------------------------------
# Tab-separated: name version sha256 path release timestamp. Owned and written
# by the privileged side only; reading refuses a record others could modify.
declare -A R=()      # R[name:field]
R_NAMES=()
REC_ERR=''
re_ts='^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'
re_path='^/[^[:cntrl:]]+$'

_load_record() {
    local name ver sha path rel ts extra
    R=(); R_NAMES=(); REC_ERR=''
    if [[ ! -e $RECORD && ! -L $RECORD ]]; then return 0; fi
    [[ -f $RECORD && ! -L $RECORD ]] || { REC_ERR='installation record is not a regular file'; return 1; }
    trusted_path "$STATE_DIR" && trusted_path "$RECORD" || { REC_ERR="untrusted installation record location: $TRUST_WHY"; return 1; }
    while IFS=$'\t' read -r name ver sha path rel ts extra || [[ -n $name ]]; do
        if [[ -z $name || $name == '#'* ]]; then continue; fi
        if [[ -n $extra || ! $name =~ $re_name || ! $ver =~ $re_version || ! $sha =~ $re_sha \
              || ! $path =~ $re_path || ! $rel =~ $re_asset || ! $ts =~ $re_ts ]]; then
            REC_ERR='installation record is malformed'; return 1
        fi
        if [[ -n ${R[$name:sha]:-} ]]; then REC_ERR="installation record repeats '$name'"; return 1; fi
        R[$name:ver]=$ver; R[$name:sha]=$sha; R[$name:path]=$path; R[$name:rel]=$rel; R[$name:ts]=$ts
        R_NAMES+=("$name")
    done < "$RECORD"
}

load_record() {
    _load_record || { R=(); R_NAMES=(); return 1; }
}

record_write() { # caller holds the lock
    local n tmp
    tmp=$(mktemp -- "$STATE_DIR/.installed.XXXXXXXX")
    CLEAN+=("$tmp")
    {
        printf '# tuk installation record v1\n'
        while read -r n; do
            [[ -n $n ]] || continue
            printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$n" "${R[$n:ver]}" "${R[$n:sha]}" "${R[$n:path]}" "${R[$n:rel]}" "${R[$n:ts]}"
        done < <(printf '%s\n' "${R_NAMES[@]}" | sort)
    } > "$tmp"
    chmod 0644 -- "$tmp"
    mv -fT -- "$tmp" "$RECORD"
}

record_set() { # name version sha path release (caller holds the lock)
    local name=$1
    if [[ -z ${R[$name:sha]:-} ]]; then R_NAMES+=("$name"); fi
    R[$name:ver]=$2; R[$name:sha]=$3; R[$name:path]=$4; R[$name:rel]=$5
    R[$name:ts]=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    record_write
}

record_unset() { # name (caller holds the lock)
    local name=$1 n keep=()
    for n in "${R_NAMES[@]}"; do if [[ $n != "$name" ]]; then keep+=("$n"); fi; done
    R_NAMES=("${keep[@]}")
    unset "R[$name:ver]" "R[$name:sha]" "R[$name:path]" "R[$name:rel]" "R[$name:ts]"
    record_write
}

take_lock() {
    if [[ -e $STATE_DIR || -L $STATE_DIR ]]; then
        [[ -d $STATE_DIR ]] || die "$STATE_DIR exists but is not a directory"
        trusted_path "$STATE_DIR" || trust_fail "untrusted state directory"
    else
        install -d -m 0755 -- "$STATE_DIR"
        trusted_path "$STATE_DIR" || trust_fail "untrusted state directory"
    fi
    exec 9>> "$STATE_DIR/lock"
    flock -w 30 9 || die 'another tuk operation holds the lock'
}

# --- State detection ---------------------------------------------------------
S_STATE=''; S_DETAIL=''; S_SHA='-'

eval_pkg() {
    local n=$1 dest=$BIN_DIR/$1 sum has_rec=0 miss unsupported=''
    if [[ $HOST_OS != Linux ]] || ! arch_ok "$n"; then
        unsupported="needs ${P[$n:os]}/${P[$n:arch]}, this host is $HOST_OS/$HOST_ARCH"
    fi
    S_STATE=''; S_DETAIL=''; S_SHA='-'
    [[ -n ${R[$n:sha]:-} ]] && has_rec=1
    if [[ -e $dest || -L $dest ]]; then
        if [[ -L $dest || ! -f $dest ]]; then
            if (( has_rec )); then S_STATE=modified; S_DETAIL='installed path is no longer a regular file'
            else S_STATE=unmanaged; S_DETAIL='existing path is a symlink or not a regular file'; fi
            return 0
        fi
        if ! sum=$(sha256_of "$dest"); then S_STATE=modified; S_DETAIL='cannot read installed file'; return 0; fi
        S_SHA=$sum
        if ! file_meta "$dest"; then S_STATE=modified; S_DETAIL='cannot stat installed file'; return 0; fi
        if (( ! has_rec )) && [[ -n $unsupported ]]; then
            S_STATE=unsupported; S_DETAIL="$unsupported; a file already exists at $dest"
        elif (( ! has_rec )); then
            S_STATE=unmanaged
            if [[ $sum == "${P[$n:payload_sha256]}" ]]; then S_DETAIL='content matches the catalogue but was not installed by tuk'
            else S_DETAIL='existing command not installed by tuk'; fi
        elif [[ $sum != "${R[$n:sha]}" ]]; then
            S_STATE=modified; S_DETAIL='content differs from the installation record'
        elif [[ $META_MODE != 755 || ( $META_OWNER != 0 && $META_OWNER != "$EUID" ) ]]; then
            S_STATE=modified; S_DETAIL="unexpected mode/owner ($META_MODE, uid $META_OWNER)"
        elif [[ ${R[$n:ver]} != "${P[$n:version]}" ]]; then
            S_STATE=outdated; S_DETAIL="installed ${R[$n:ver]}, catalogue ${P[$n:version]}"
        elif [[ $sum != "${P[$n:payload_sha256]}" ]]; then
            S_STATE=modified; S_DETAIL='content differs from the catalogue hash'
        else
            S_STATE=verified
        fi
        return 0
    fi
    # Gone-but-recorded is drift and is reported before platform or dependency problems.
    if (( has_rec )); then S_STATE=missing; S_DETAIL='recorded as installed but the file is gone'; return 0; fi
    if [[ -n $unsupported ]]; then S_STATE=unsupported; S_DETAIL=$unsupported; return 0; fi
    miss=$(missing_requires "$n")
    if [[ -n $miss ]]; then S_STATE=missing-dependency; S_DETAIL="missing: $miss"; return 0; fi
    S_STATE=not-installed
}

# Why a tool that is not on disk cannot be installed on this host ("" if it can).
install_blockers() {
    local miss
    if [[ $HOST_OS != Linux ]] || ! arch_ok "$1"; then
        printf 'not available on this host (needs %s/%s, this host is %s/%s)' "${P[$1:os]}" "${P[$1:arch]}" "$HOST_OS" "$HOST_ARCH"
        return 0
    fi
    miss=$(missing_requires "$1")
    if [[ -n $miss ]]; then printf 'cannot install yet, missing: %s (install the missing prerequisite and retry)' "$miss"; fi
}

tmp_base() {
    local b=${TMPDIR:-/tmp}
    [[ $b == /* ]] || die "TMPDIR must be an absolute path (it is '$b')"
    printf '%s' "$b"
}

load_all_or_die() {
    load_catalogue_or_die
    load_record || die "$REC_ERR"
}

# --- Commands ----------------------------------------------------------------
cmd_list() {
    local n
    load_all_or_die
    printf '%-10s %-9s %-18s %s\n' NAME VERSION STATUS DESCRIPTION
    for n in "${PKG_NAMES[@]}"; do
        eval_pkg "$n"
        printf '%-10s %-9s %-18s %s\n' "$n" "${P[$n:version]}" "$S_STATE" "${P[$n:description]}"
    done
}

cmd_status() {
    local n bad=0 mgr_sha mgr_state notes=()
    load_all_or_die
    printf '%-10s %-9s %-18s %s\n' NAME VERSION STATE SHA256
    # The manager is checked against its own record: the catalogue cannot pin it.
    if [[ -f $BIN_DIR/tuk && ! -L $BIN_DIR/tuk ]]; then
        mgr_sha=$(sha256_of "$BIN_DIR/tuk") || mgr_sha=unreadable
        # No record means the manager's integrity cannot be verified: treated as a failure.
        if [[ -z ${R[tuk:sha]:-} ]]; then mgr_state=unmanaged; bad=1; notes+=('tuk: the manager has no installation record, so its integrity cannot be verified (re-run ./bootstrap from a reviewed checkout)')
        elif [[ $mgr_sha == "${R[tuk:sha]}" ]]; then mgr_state=verified
        else mgr_state=modified; bad=1; notes+=('tuk: manager differs from its installation record'); fi
        printf '%-10s %-9s %-18s %s\n' tuk "${R[tuk:ver]:--}" "$mgr_state" "$mgr_sha"
    else
        printf '%-10s %-9s %-18s %s\n' tuk - not-installed -
    fi
    for n in "${PKG_NAMES[@]}"; do
        eval_pkg "$n"
        printf '%-10s %-9s %-18s %s\n' "$n" "${R[$n:ver]:-${P[$n:version]}}" "$S_STATE" "$S_SHA"
        if [[ -n $S_DETAIL ]]; then notes+=("$n: $S_DETAIL"); fi
        if [[ $S_STATE == modified || $S_STATE == missing ]]; then bad=1; fi
    done
    if (( ${#notes[@]} )); then printf '\nNotes:\n'; printf '  %s\n' "${notes[@]}"; fi
    return "$bad"
}

fetch_asset() { # release asset out maxbytes
    local proto=(--proto '=https' --proto-redir '=https' --tlsv1.2)
    if [[ $BASE_URL == file:///* ]]; then proto=(--proto '=file'); fi
    curl "${proto[@]}" --fail --silent --show-error --location --max-redirs 5 \
        --connect-timeout 20 --max-time 1800 --max-filesize "$4" --output "$3" \
        "$BASE_URL/$1/$2" || return 1
}

check_file() { # file expected_size expected_sha label
    local size sum
    [[ -f $1 && ! -L $1 ]] || { printf 'tuk: %s is missing\n' "$4" >&2; return 1; }
    if [[ -n $2 ]]; then
        size=$(stat -c %s -- "$1")
        [[ $size == "$2" ]] || { printf 'tuk: %s has the wrong size (%s, expected %s)\n' "$4" "$size" "$2" >&2; return 1; }
    fi
    sum=$(sha256_of "$1") || return 1
    [[ $sum == "$3" ]] || { printf 'tuk: %s failed SHA-256 verification; discarded\n' "$4" >&2; return 1; }
}

verify_installed() { # path expected_sha
    [[ -f $1 && ! -L $1 ]] || return 1
    [[ $(sha256_of "$1") == "$2" ]] || return 1
    file_meta "$1" || return 1
    [[ $META_MODE == 755 && $META_OWNER == "$EUID" ]]
}

# Copy a user-controlled staged file into the root-private stage: regular file
# only, never more than max+1 bytes, and time-limited so a FIFO or a stalled
# file cannot hold the lock. The result is re-checked by size and SHA-256.
copy_bounded() { # src dst max
    [[ -f $1 && ! -L $1 ]] || { printf 'tuk: staged file is missing or not a regular file: %s\n' "${1##*/}" >&2; return 1; }
    timeout 60 head -c "$(( $3 + 1 ))" -- "$1" > "$2" || { printf 'tuk: could not read staged file %s\n' "${1##*/}" >&2; return 1; }
}

# After a failed post-install verification: move the file aside ONLY if it can be
# attributed to this install attempt. Evidence required (all of it): the installer
# exited 0 for a destination that did not exist (it publishes with an atomic,
# non-overwriting link); the destination is a regular non-symlink file owned by
# this process, with a single link, whose change time is not before the attempt began;
# and the destination directory was verified trusted. Anything else is preserved.
quarantine_or_preserve() { # name dest start_epoch
    local n=$1 dest=$2 t0=$3 why='' out owner nlink ctime ino q
    if [[ -L $dest || ! -f $dest ]]; then
        why='it is not a regular file'
    elif ! out=$(stat -c '%u %h %Z %i' -- "$dest"); then
        why='it could not be inspected'
    else
        read -r owner nlink ctime ino <<< "$out"
        if [[ $owner != "$EUID" ]]; then why="it is owned by uid $owner, not by this process"
        elif [[ $nlink != 1 ]]; then why="it has $nlink hard links"
        elif (( ctime < t0 )); then why='its change time is earlier than the start of this install attempt'
        fi
    fi
    if [[ -n $why ]]; then
        printf 'tuk: *** %s FAILED POST-INSTALL VERIFICATION ***\n' "$n" >&2
        printf 'tuk: *** %s was NOT moved: it cannot be attributed to this install attempt (%s). It is still in place and may be executable.\n' "$dest" "$why" >&2
        printf 'tuk: *** Inspect it and decide by hand. Nothing was recorded; tuk treats it as an unmanaged command.\n' >&2
        return 1
    fi
    q=$(mktemp -u -- "${dest%/*}/.$n.failed.XXXXXXXX")
    if mv -n -T -- "$dest" "$q" && [[ ! -e $dest ]] && [[ $(stat -c %i -- "$q") == "$ino" ]]; then
        chmod a-x -- "$q" || true
        printf 'tuk: *** %s FAILED POST-INSTALL VERIFICATION ***\n' "$n" >&2
        printf 'tuk: *** The file created by this install did not match the expected hash, mode or owner. It was moved to %s and made non-executable;\n' "$q" >&2
        printf 'tuk: *** %s is free again. Nothing was recorded. Inspect the quarantined file, then delete it and retry.\n' "$dest" >&2
    else
        printf 'tuk: *** %s FAILED POST-INSTALL VERIFICATION and quarantine did not complete cleanly; check %s and %s by hand ***\n' "$n" "$dest" "$q" >&2
    fi
    return 1
}

# Privileged half of an install. Treats the unprivileged staging directory as
# untrusted: files are copied into a root-private directory and re-verified there.
priv_install_pkg() { # name uploaded_dir
    local n=$1 up=$2 payload installer stage out dest f blockers t0
    (( EUID == 0 || TEST_MODE )) || die 'internal command: must run as root'
    [[ $n =~ $re_name ]] || die "invalid package name '$n'"
    [[ $up == /* ]] || die "the staging directory must be an absolute path (got '$up')"
    load_catalogue_or_die
    [[ -n ${P[$n:version]:-} ]] || die "unknown package '$n'"
    payload=${P[$n:payload]}; installer=${P[$n:installer]}; dest=$BIN_DIR/$n
    trusted_path "$BIN_DIR" || trust_fail "refusing to install into $BIN_DIR"
    take_lock
    load_record || die "$REC_ERR"
    eval_pkg "$n"
    case $S_STATE in
        not-installed|missing) ;;
        verified) printf '%s %s is already installed and verified\n' "$n" "${P[$n:version]}"; return 0 ;;
        *) die "refusing to install $n: state is $S_STATE${S_DETAIL:+ ($S_DETAIL)}" ;;
    esac
    blockers=$(install_blockers "$n")
    [[ -z $blockers ]] || die "refusing to install $n: $blockers"
    stage=$(mktemp -d -- "$STATE_DIR/stage.XXXXXXXX")
    CLEAN+=("$stage")
    copy_bounded "$up/$payload" "$stage/$payload" "${P[$n:payload_size]}" || exit 1
    copy_bounded "$up/$installer" "$stage/$installer" "$MAX_INSTALLER" || exit 1
    check_file "$stage/$payload" "${P[$n:payload_size]}" "${P[$n:payload_sha256]}" "$payload" || exit 1
    check_file "$stage/$installer" '' "${P[$n:installer_sha256]}" "$installer" || exit 1
    # The manifest the installer trusts comes from the catalogue, not the download.
    printf '%s  %s\n' "${P[$n:payload_sha256]}" "$payload" > "$stage/${P[$n:manifest]}"
    chmod 0644 -- "$stage/$payload" "$stage/$installer" "$stage/${P[$n:manifest]}"
    t0=$(date +%s)
    if ! out=$(bash "$stage/$installer" "$stage/$payload" "$BIN_DIR" 2>&1); then
        die "installer refused $n; nothing installed: ${out//$'\n'/ }"
    fi
    if ! verify_installed "$dest" "${P[$n:payload_sha256]}"; then
        quarantine_or_preserve "$n" "$dest" "$t0" || true
        exit 1
    fi
    record_set "$n" "${P[$n:version]}" "${P[$n:payload_sha256]}" "$dest" "${P[$n:release]}"
    printf 'Installed %s %s: %s (SHA-256 %s, verified)\n' "$n" "${P[$n:version]}" "$dest" "${P[$n:payload_sha256]}"
    JUST_INSTALLED=1
}

# Privileged entry point: one process (and one sudo) for every staged package.
# A failure ends the run (die); the exit handler lists tools already installed.
priv_install_all() { # staging_dir name...
    local up=$1 n
    shift
    for n in "$@"; do
        JUST_INSTALLED=0
        priv_install_pkg "$n" "$up/$n"
        if (( JUST_INSTALLED )); then DONE_LIST+=("$n"); fi
    done
}

cmd_install() {
    local dry=0 names=() n a fetch_dir dir problems=0 todo=() miss blockers tmpbase
    local -A want=()
    for a in "$@"; do
        case $a in
            --dry-run) dry=1 ;;
            -*) usage_error "unknown option '$a'" ;;
            *) [[ $a =~ $re_name ]] || usage_error "invalid package name '$a'"
               if [[ -z ${want[$a]:-} ]]; then want[$a]=1; names+=("$a"); fi ;;
        esac
    done
    (( ${#names[@]} > 0 )) || usage_error 'install needs at least one package name'
    load_all_or_die
    # Preflight everything first: a bad request changes nothing.
    for n in "${names[@]}"; do
        if [[ -z ${P[$n:version]:-} ]]; then printf 'tuk: %s: not in the catalogue\n' "$n" >&2; problems=1; continue; fi
        eval_pkg "$n"
        case $S_STATE in
            not-installed|missing)
                # A recorded-but-deleted tool is still subject to the platform and dependency checks.
                blockers=$(install_blockers "$n")
                if [[ -n $blockers ]]; then printf 'tuk: %s: %s\n' "$n" "$blockers" >&2; problems=1; else todo+=("$n"); fi ;;
            verified) printf '%s %s is already installed and verified\n' "$n" "${P[$n:version]}" ;;
            outdated) printf 'tuk: %s: a different version is installed (%s); upgrades are not implemented\n' "$n" "$S_DETAIL" >&2; problems=1 ;;
            missing-dependency) printf 'tuk: %s: cannot install yet, %s (install the missing prerequisite and retry)\n' "$n" "$S_DETAIL" >&2; problems=1 ;;
            unsupported) printf 'tuk: %s: not available on this host (%s)\n' "$n" "$S_DETAIL" >&2; problems=1 ;;
            *) printf 'tuk: %s: %s (%s); not touching it\n' "$n" "$S_STATE" "$S_DETAIL" >&2; problems=1 ;;
        esac
    done
    (( problems == 0 )) || die 'nothing was installed'
    (( ${#todo[@]} > 0 )) || return 0
    for n in "${REQUIRED_TOOLS[@]}"; do
        command -v -- "$n" > /dev/null 2>&1 || miss+="${miss:+ }$n"
    done
    if (( dry )); then
        # A preview must not fail for reasons unrelated to the preview: warn instead.
        [[ -z ${miss:-} ]] || warn "missing required tools: $miss (a real install would stop here)"
        check_location "$BIN_DIR" || warn "a real install would be refused: $TRUST_WHY"
        for n in "${todo[@]}"; do
            printf 'would install %s %s to %s/%s\n  %s/%s/%s\n  %s/%s/%s\n' "$n" "${P[$n:version]}" "$BIN_DIR" "$n" \
                "$BASE_URL" "${P[$n:release]}" "${P[$n:payload]}" "$BASE_URL" "${P[$n:release]}" "${P[$n:installer]}"
        done
        if (( EUID == 0 || TEST_MODE )); then printf 'a real install runs as the current user (root or test mode); nothing was fetched or changed\n'
        else printf 'a real install needs root: tuk would use sudo for the final step; nothing was fetched or changed\n'; fi
        return 0
    fi
    [[ -z ${miss:-} ]] || die "missing required tools: $miss"
    # Fail before any download if the destination would be refused anyway.
    check_location "$BIN_DIR" || trust_fail "cannot install into $BIN_DIR; nothing was downloaded"
    tmpbase=$(tmp_base)
    if (( EUID != 0 && ! TEST_MODE )); then
        command -v sudo > /dev/null 2>&1 || die 'installing needs root: run as root or install sudo'
        [[ -f $BIN_DIR/tuk && ! -L $BIN_DIR/tuk && $(stat -c %u -- "$BIN_DIR/tuk") == 0 ]] \
            || die "$BIN_DIR/tuk is not a root-owned installed manager; run ./bootstrap"
        # Authenticate sudo once, up front, before anything is downloaded.
        sudo -v || die 'sudo authentication failed; nothing was installed'
    fi
    # Phase 1, unprivileged: fetch and verify EVERYTHING before changing the system,
    # so a download or hash failure for any package installs none of them.
    fetch_dir=$(mktemp -d "$tmpbase/tuk-fetch.XXXXXXXX")
    CLEAN+=("$fetch_dir")
    for n in "${todo[@]}"; do
        dir=$fetch_dir/$n
        mkdir -m 0700 -- "$dir"
        printf 'Fetching %s %s (%s)\n' "$n" "${P[$n:version]}" "${P[$n:release]}"
        fetch_asset "${P[$n:release]}" "${P[$n:payload]}" "$dir/${P[$n:payload]}" "${P[$n:payload_size]}" || die "download of ${P[$n:payload]} failed; nothing was installed"
        fetch_asset "${P[$n:release]}" "${P[$n:installer]}" "$dir/${P[$n:installer]}" "$MAX_INSTALLER" || die "download of ${P[$n:installer]} failed; nothing was installed"
        check_file "$dir/${P[$n:payload]}" "${P[$n:payload_size]}" "${P[$n:payload_sha256]}" "${P[$n:payload]}" || die "$n failed verification; nothing was installed"
        check_file "$dir/${P[$n:installer]}" '' "${P[$n:installer_sha256]}" "${P[$n:installer]}" || die "$n failed verification; nothing was installed"
    done
    # Phase 2, privileged, in ONE process: each package is re-verified by root. A
    # refusal stops the run; tools already installed are kept and listed.
    if (( EUID == 0 || TEST_MODE )); then
        priv_install_all "$fetch_dir" "${todo[@]}"
    else
        sudo -- "$BIN_DIR/tuk" _install-staged "$fetch_dir" "${todo[@]}"
    fi
}

# Installs this script and its catalogue next to each other. Invoked by
# ./bootstrap from a clone; replaces nothing unless --upgrade-manager is given
# and the installed file is exactly what tuk previously recorded.
plan_managed() { # src dest row mode upgrade -> prints new|same|replace, or dies
    local src=$1 dest=$2 row=$3 mode=$4 upgrade=$5 ssum dsum what
    ssum=$(sha256_of "$src")
    if [[ ! -e $dest && ! -L $dest ]]; then echo new; return 0; fi
    [[ -f $dest && ! -L $dest ]] || die "$dest exists and is not a regular file; not touching it"
    dsum=$(sha256_of "$dest") || die "cannot read $dest"
    file_meta "$dest" || die "cannot stat $dest"
    if [[ $dsum == "$ssum" ]]; then
        (( 8#$META_MODE == 8#$mode )) && [[ $META_OWNER == "$EUID" ]] || die "$dest has the right content but unexpected mode or owner ($META_MODE, uid $META_OWNER); not touching it"
        echo same; return 0
    fi
    if [[ -z ${R[$row:sha]:-} || $dsum != "${R[$row:sha]}" ]]; then
        die "$dest differs from this checkout and is not recognised as tuk's own unmodified installation (no matching installation record: it was edited, installed by hand, or the record was lost). Not replacing it, even with --upgrade-manager; review it and move it aside"
    fi
    # From here the installed file is exactly what tuk recorded.
    if [[ $row == tuk ]]; then what="the installed tuk manager (${R[$row:ver]}) differs from the one in this checkout ($TUK_VERSION)"
    else what='the installed package catalogue differs from the one in this checkout; replacing it changes which releases and SHA-256 values this host trusts'; fi
    if (( ! upgrade )); then
        die "$dest: $what. Review the checkout (for example diff the files), then re-run ./bootstrap --upgrade-manager to replace it. Nothing was changed"
    fi
    (( 8#$META_MODE == 8#$mode )) && [[ $META_OWNER == "$EUID" ]] || die "$dest has the recorded content but unexpected mode or owner ($META_MODE, uid $META_OWNER); not replacing it"
    echo replace
}

apply_managed() { # src dest row mode action
    local src=$1 dest=$2 row=$3 mode=$4 action=$5 tmp ssum
    ssum=$(sha256_of "$src")
    case $action in
        same)
            if [[ ${R[$row:sha]:-} != "$ssum" ]]; then record_set "$row" "$TUK_VERSION" "$ssum" "$dest" manager; fi
            printf '%s is already up to date\n' "$dest"; return 0 ;;
        replace)
            tmp=$(mktemp -- "${dest%/*}/.tuk.XXXXXXXX"); CLEAN+=("$tmp")
            cp -- "$src" "$tmp"; chmod "$mode" -- "$tmp"
            mv -fT -- "$tmp" "$dest"
            printf 'Upgraded %s\n' "$dest" ;;
        new)
            tmp=$(mktemp -- "${dest%/*}/.tuk.XXXXXXXX"); CLEAN+=("$tmp")
            cp -- "$src" "$tmp"; chmod "$mode" -- "$tmp"
            ln -T -- "$tmp" "$dest" || die "$dest appeared while installing; not overwriting"
            rm -f -- "$tmp"
            printf 'Installed %s\n' "$dest" ;;
    esac
    [[ $(sha256_of "$dest") == "$ssum" ]] || die "$dest failed post-install verification"
    record_set "$row" "$TUK_VERSION" "$ssum" "$dest" manager
}

cmd_self_install() {
    local upgrade=0 src srcdir stage a cat_action tuk_action
    for a in "$@"; do
        if [[ $a == --upgrade-manager ]]; then upgrade=1; else usage_error "unknown option '$a'"; fi
    done
    (( EUID == 0 || TEST_MODE )) || die 'internal command: run ./bootstrap'
    src=$(realpath -e -- "${BASH_SOURCE[0]}")
    srcdir=${src%/*}
    [[ -f $srcdir/packages.conf && ! -L $srcdir/packages.conf ]] || die "packages.conf not found next to tuk in $srcdir"
    stage=$(mktemp -d "$(tmp_base)/tuk-self.XXXXXXXX")
    CLEAN+=("$stage")
    cp -- "$src" "$stage/tuk"
    cp -- "$srcdir/packages.conf" "$stage/packages.conf"
    load_catalogue "$stage/packages.conf" || die "refusing to install an invalid catalogue: $CAT_ERR"
    [[ -d $BIN_DIR ]] || install -d -m 0755 -- "$BIN_DIR"
    [[ -d $LIB_DIR ]] || install -d -m 0755 -- "$LIB_DIR"
    trusted_path "$BIN_DIR" || trust_fail "refusing to install into $BIN_DIR"
    trusted_path "$LIB_DIR" || trust_fail "refusing to install into $LIB_DIR"
    take_lock
    load_record || die "$REC_ERR"
    # Decide both before touching either, so a refusal never half-updates the pair.
    cat_action=$(plan_managed "$stage/packages.conf" "$CATALOGUE" catalogue 0644 "$upgrade")
    tuk_action=$(plan_managed "$stage/tuk" "$BIN_DIR/tuk" tuk 0755 "$upgrade")
    if [[ $cat_action == replace ]]; then
        # If the manager step fails after the catalogue is replaced, the exit handler restores this copy.
        cp -- "$CATALOGUE" "$stage/previous-packages.conf"
        ROLLBACK_SRC=$stage/previous-packages.conf; ROLLBACK_DEST=$CATALOGUE
        ROLLBACK_SHA=${R[catalogue:sha]}; ROLLBACK_VER=${R[catalogue:ver]}
    fi
    if [[ $cat_action == new ]]; then
        # A catalogue created by this run is removed again if the manager step fails.
        ROLLBACK_NEW_DEST=$CATALOGUE; ROLLBACK_NEW_SHA=$(sha256_of "$stage/packages.conf")
    fi
    apply_managed "$stage/packages.conf" "$CATALOGUE" catalogue 0644 "$cat_action"
    apply_managed "$stage/tuk" "$BIN_DIR/tuk" tuk 0755 "$tuk_action"
    ROLLBACK_SRC=''; ROLLBACK_NEW_DEST=''
}

DOCTOR_FAILS=0
doctor_ok() { printf '  ok    %s\n' "$*"; }
doctor_bad() { printf '  FAIL  %s\n' "$*"; DOCTOR_FAILS=1; }
doctor_wrn() { printf '  warn  %s\n' "$*"; }

cmd_doctor() {
    local c n rec_ok cat_ok=0
    DOCTOR_FAILS=0
    printf 'tuk %s doctor (read-only)\n' "$TUK_VERSION"
    if [[ $HOST_OS == Linux ]]; then doctor_ok "platform $HOST_OS/$HOST_ARCH"; else doctor_bad "unsupported operating system $HOST_OS"; fi
    for c in "${REQUIRED_TOOLS[@]}"; do
        if command -v -- "$c" > /dev/null 2>&1; then doctor_ok "tool $c"; else doctor_bad "required tool missing: $c"; fi
    done
    if (( EUID != 0 && ! TEST_MODE )); then
        if command -v sudo > /dev/null 2>&1; then doctor_ok 'sudo available'; else doctor_wrn 'sudo not found: run tuk as root to install'; fi
    fi
    if check_location "$BIN_DIR"; then doctor_ok "$BIN_DIR and its parent directories are trusted"
    else doctor_bad "$BIN_DIR: $TRUST_WHY. $(trust_advice)"; fi
    if [[ -e $CATALOGUE ]]; then
        if trusted_path "$LIB_DIR" && trusted_path "$CATALOGUE"; then
            doctor_ok 'catalogue location is trusted'
            if load_catalogue "$CATALOGUE"; then doctor_ok "catalogue valid (${#PKG_NAMES[@]} packages)"; cat_ok=1
            else doctor_bad "catalogue invalid: $CAT_ERR"; fi
        else
            # Never read, or report on, a catalogue from a location every other command refuses.
            doctor_bad "catalogue location: $TRUST_WHY. $(trust_advice)"
            doctor_wrn 'catalogue not read and per-tool checks skipped: its location is untrusted'
        fi
    else
        doctor_bad "catalogue not found at $CATALOGUE"
    fi
    if [[ -f $BIN_DIR/tuk && ! -L $BIN_DIR/tuk ]]; then
        if file_meta "$BIN_DIR/tuk" && (( 8#$META_MODE == 8#755 )) && owner_ok "$META_OWNER"; then doctor_ok 'manager mode and owner'; else doctor_bad "manager has unexpected mode or owner ($META_MODE, uid $META_OWNER)"; fi
    fi
    rec_ok=1
    if [[ -d $STATE_DIR ]]; then
        if load_record; then doctor_ok "installation record readable (${#R_NAMES[@]} entries)"; else doctor_bad "$REC_ERR"; rec_ok=0; fi
    else
        doctor_ok 'no installation record yet'
    fi
    if (( cat_ok )); then
        for n in "${PKG_NAMES[@]}"; do
            if (( rec_ok )); then
                eval_pkg "$n"
                case $S_STATE in
                    verified|not-installed) doctor_ok "$n $S_STATE" ;;
                    *) doctor_wrn "$n $S_STATE${S_DETAIL:+: $S_DETAIL}" ;;
                esac
            elif [[ -f $BIN_DIR/$n && ! -L $BIN_DIR/$n ]]; then
                # Without a readable record only the catalogue comparison is meaningful.
                if [[ $(sha256_of "$BIN_DIR/$n" || true) == "${P[$n:payload_sha256]}" ]]; then doctor_wrn "$n: file matches the catalogue hash (record unreadable, so ownership by tuk is unknown)"
                else doctor_wrn "$n: file differs from the catalogue hash (record unreadable)"; fi
            else
                doctor_wrn "$n: not checked (record unreadable)"
            fi
        done
    fi
    case ":$PATH:" in *":$BIN_DIR:"*) doctor_ok "$BIN_DIR is on PATH" ;; *) doctor_wrn "$BIN_DIR is not on PATH" ;; esac
    return "$DOCTOR_FAILS"
}

usage() {
    cat <<'EOF'
Usage: tuk COMMAND [ARGS]

Commands:
  list                    Show available tools, versions and installation state.
  install [--dry-run] NAME [NAME...]
                          Install approved tools. Never overwrites an existing
                          command; --dry-run prints what would be fetched.
  status                  Show installed tools, hashes and any drift.
                          Exit 0: nothing is modified or missing and the manager
                          has an installation record. Exit 1: a tool or the
                          manager is modified or missing, or the manager has no
                          record. unmanaged, outdated and unsupported tools are
                          informational and do not change the exit status.
  doctor                  Read-only checks of prerequisites, catalogue and record.
  --version, --help

States: not-installed, verified, modified (hash/mode differs from the record),
missing, outdated, unmanaged (a command tuk did not install), unsupported,
missing-dependency.

Tools come from a reviewed catalogue of pinned releases and SHA-256 values.
Installing needs root: run as root, or tuk uses sudo for the final step.
EOF
}

case ${1:-} in
    list) shift; (( $# == 0 )) || usage_error 'list takes no arguments'; cmd_list ;;
    status) shift; (( $# == 0 )) || usage_error 'status takes no arguments'; cmd_status ;;
    doctor) shift; (( $# == 0 )) || usage_error 'doctor takes no arguments'; cmd_doctor ;;
    install) shift; cmd_install "$@" ;;
    _install-staged) shift; (( $# >= 2 )) || usage_error 'bad arguments'; (( EUID == 0 || TEST_MODE )) || die 'internal command: must run as root'; load_catalogue_or_die; priv_install_all "$@" ;;
    _catalogue-names) shift; (( $# == 1 )) || usage_error 'bad arguments'
        load_catalogue "$1" || die "invalid catalogue: $CAT_ERR"
        for n in "${PKG_NAMES[@]}"; do printf '%s\t%s\t%s\n' "$n" "${P[$n:version]}" "${P[$n:description]}"; done ;;
    _required-tools) shift; (( $# == 0 )) || usage_error 'bad arguments'; printf '%s\n' "${REQUIRED_TOOLS[@]}" ;;
    _check-destination) shift; (( $# == 0 )) || usage_error 'bad arguments'
        for n in "$BIN_DIR" "$LIB_DIR" "$STATE_DIR"; do
            check_location "$n" || trust_fail "cannot install: $n is not in a trusted location; nothing was changed"
        done ;;
    _self-install) shift; cmd_self_install "$@" ;;
    -V|--version|version) printf 'tuk %s\n' "$TUK_VERSION" ;;
    -h|--help|help) usage ;;
    '') usage >&2; exit 2 ;;
    *) usage_error "unknown command '$1'" ;;
esac
